    <WindowsOnlyFact>
    Public Sub KnownIssue_RemovingTheRegion_RestoresTheOriginalFile()

        Using sandbox As New ProgramSandbox()

            Dim original As String = "using System;" & vbLf & "internal class C { }" & vbLf
            Dim withMembers As String = "using System;" & vbLf & "public class C { public void M() {} }" & vbLf
            sandbox.Source.WriteText("a.cs", withMembers, ProgramEndToEndTests.NoBomUtf8)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, sandbox.Run())

            ' Now the public members disappear: the application removes the region.
            Dim textWithRegion As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs").Replace("public class C { public void M() {} }", "internal class C { }")
            sandbox.Source.WriteText("a.cs", textWithRegion, ProgramEndToEndTests.NoBomUtf8)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, sandbox.Run())

            Assert.Equal(original, ProgramEndToEndTests.Lf(ProgramEndToEndTests.ReadText(sandbox, "a.cs")))

        End Using

    End Sub

    <WindowsOnlyFact>
    Public Sub KnownIssue_TheRegionUsesTheLineBreaksOfTheFile()

        Using sandbox As New ProgramSandbox()

            Dim original As String = "using System;" & vbCrLf & "public class C { public void M() {} }" & vbCrLf
            sandbox.Source.WriteText("crlf.cs", original, ProgramEndToEndTests.NoBomUtf8)
            Dim originalLf As String = original.Replace(vbCrLf, vbLf)
            sandbox.Source.WriteText("lf.cs", originalLf, ProgramEndToEndTests.NoBomUtf8)

            ProgramEndToEndTests.AssertExitCode(0, sandbox.Run())

            Dim crlfText As String = ProgramEndToEndTests.ReadText(sandbox, "crlf.cs")
            Dim lfText As String = ProgramEndToEndTests.ReadText(sandbox, "lf.cs")
            Assert.Equal(crlfText, crlfText.Replace(vbCrLf, vbLf).Replace(vbLf, vbCrLf))
            Assert.DoesNotContain(vbCr, lfText, StringComparison.Ordinal)

        End Using

    End Sub

