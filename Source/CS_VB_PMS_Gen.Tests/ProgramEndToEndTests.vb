        End Using

    End Sub

#End Region

#Region " Insertion "

    ''' <summary>
    ''' The region is inserted at the top of a file that starts with code.
    ''' The rest of the file is exactly what it was.
    ''' </summary>
    <WindowsOnlyTheory>
    <InlineData("a.cs", "using System;" & vbLf & "public class C { public void M() {} }" & vbLf)>
    <InlineData("a.vb", "Public Class C" & vbLf & "    Public Sub M()" & vbLf & "    End Sub" & vbLf & "End Class" & vbLf)>
    Public Sub Run_InsertsTheRegionAtTheTopOfTheFile_AndKeepsTheRestIntact(fileName As String, original As String)

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText(fileName, original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, result)
            ProgramEndToEndTests.AssertOutputContains("Summary was successfully inserted into file at line 1.", result)

            Dim text As String = ProgramEndToEndTests.ReadText(sandbox, fileName)
            Assert.Matches("^#(region|Region) ""? ?Public Members Summary", text)
            Assert.Equal(original, ProgramEndToEndTests.Lf(ProgramEndToEndTests.WithoutRegion(text)))

        End Using

    End Sub

    ''' <summary>
    ''' When the file starts with comments (a license header, for instance), the region is inserted after them, just before the first code.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_InsertsTheRegionAfterTheLeadingComments()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertOutputContains("Summary was successfully inserted into file at line 2.", result)

            Dim text As String = ProgramEndToEndTests.Lf(ProgramEndToEndTests.ReadText(sandbox, "a.cs"))
            Assert.StartsWith("// Ñandú café" & vbLf & "#region Public Members Summary", text, StringComparison.Ordinal)
            Assert.Equal(ProgramEndToEndTests.CsSource, ProgramEndToEndTests.WithoutRegion(text))

        End Using

    End Sub

    ''' <summary>
    ''' When the first code of the file is a directive, the region is inserted before it.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_InsertsTheRegionBeforeALeadingDirective()

        Using sandbox As New ProgramSandbox()

            Dim original As String = "#nullable enable" & vbLf & "public class C { public void M() {} }" & vbLf
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            ProgramEndToEndTests.AssertExitCode(0, sandbox.Run())

            Dim text As String = ProgramEndToEndTests.Lf(ProgramEndToEndTests.ReadText(sandbox, "a.cs"))
            Assert.StartsWith("#region Public Members Summary", text, StringComparison.Ordinal)
            Assert.Equal(original, ProgramEndToEndTests.WithoutRegion(text))

        End Using

    End Sub

    <WindowsOnlyFact>
    Public Sub Run_VisualBasicFileWithOptionStatements_GetsTheRegionBeforeThem()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("a.vb", ProgramEndToEndTests.VbSource, ProgramEndToEndTests.NoBomUtf8)

            ProgramEndToEndTests.AssertExitCode(0, sandbox.Run())

            Dim text As String = ProgramEndToEndTests.Lf(ProgramEndToEndTests.ReadText(sandbox, "a.vb"))
            Assert.StartsWith("#Region "" Public Members Summary", text, StringComparison.Ordinal)
            Assert.Contains("' C.M()", text)
            Assert.Equal(ProgramEndToEndTests.VbSource, ProgramEndToEndTests.WithoutRegion(text))

        End Using

    End Sub

    ''' <summary>
    ''' The generated region has the members of the file, and the output reports how many of them there are.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_TheRegionListsTheMembersOfTheFile_AndTheOutputShowsTheirCount()

        Using sandbox As New ProgramSandbox()

            Dim original As String = "public class C { public C() {} public int P { get; set; } public int F; public void M() {} public enum E { A } private int Hidden; }" & vbLf
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertOutputContains("Generated summary contains 5 public members.", result)

            Dim text As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs")
            Assert.Contains("// C()", text)
            Assert.Contains("// int C.P", text)
            Assert.Contains("// int C.F", text)
            Assert.Contains("// void C.M()", text)
            Assert.Contains("// C.E : int", text)
            Assert.DoesNotContain("Hidden", text.Substring(0, text.IndexOf("public class", StringComparison.Ordinal)))

        End Using

    End Sub

    ''' <summary>
    ''' A file in which the summary would be empty is skipped: there is nothing to insert.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_FileWithoutPublicMembersAndWithoutRegion_IsSkippedAndNotModified()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsWithoutMembers, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(0, 1, 0, result)
            ProgramEndToEndTests.AssertOutputContains("No public members were detected", result)
            Assert.Equal(ProgramEndToEndTests.CsWithoutMembers, ProgramEndToEndTests.ReadText(sandbox, "a.cs"))

        End Using

    End Sub

    ''' <summary>
    ''' A region of another name (not the summary) is not touched, and does not prevent the insertion of the summary.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_OtherRegions_AreNotTouched()

        Using sandbox As New ProgramSandbox()

            Dim original As String = "#region Fields" & vbLf & "public class C { public int F; }" & vbLf & "#endregion" & vbLf
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            ProgramEndToEndTests.AssertExitCode(0, sandbox.Run())

            Dim text As String = ProgramEndToEndTests.Lf(ProgramEndToEndTests.ReadText(sandbox, "a.cs"))
            Assert.Equal(original, ProgramEndToEndTests.WithoutRegion(text))
            Assert.Equal(1, ProgramEndToEndTests.CountOf(text, "#region Public Members Summary"))

        End Using

    End Sub

#End Region

#Region " Replacement, Update And Removal "

    ''' <summary>
    ''' An outdated region is replaced by a new one: only one region remains, with the current members, and the rest of the file is intact.
    ''' </summary>
    <WindowsOnlyTheory>
    <InlineData("a.cs", "#region Public Members Summary (old)" & vbLf & "// void Old()" & vbLf & "#endregion" & vbLf & vbLf & "public class C { public void M() {} }" & vbLf)>
    <InlineData("a.vb", "#Region "" Public Members Summary (old) """ & vbLf & "' C.Old()" & vbLf & "#End Region" & vbLf & vbLf & "Public Class C" & vbLf & "    Public Sub M()" & vbLf & "    End Sub" & vbLf & "End Class" & vbLf)>
    Public Sub Run_ReplacesAnOutdatedRegion(fileName As String, original As String)

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText(fileName, original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, result)
            ProgramEndToEndTests.AssertOutputContains("Summary region was found in file", result)

            Dim text As String = ProgramEndToEndTests.Lf(ProgramEndToEndTests.ReadText(sandbox, fileName))
            Assert.DoesNotContain("Old()", text)
            Assert.Contains("C.M()", text)
            Assert.Equal(1, ProgramEndToEndTests.CountOf(text, "Public Members Summary"))

            ' Everything after the old region is unchanged: the code starts after the blank line that followed the region.
            Dim expectedTail As String = original.Substring(original.IndexOf(vbLf & vbLf, StringComparison.Ordinal) + 2)
            Assert.EndsWith(expectedTail, text, StringComparison.Ordinal)

        End Using

    End Sub

    ''' <summary>
    ''' The region name is searched with a tolerant, case-insensitive expression ("member"/"members", "summary"/"sumary"...).
    ''' </summary>
    <WindowsOnlyTheory>
    <InlineData("public members summary")>
    <InlineData("PUBLIC MEMBERS SUMMARY")>
    <InlineData("Public Member Summary")>
    <InlineData("Public  Members  Sumary")>
    <InlineData("Public Members Summry")>
    Public Sub Run_RecognizesTheVariantsOfTheRegionName(regionName As String)

        Using sandbox As New ProgramSandbox()

            Dim original As String = $"#region {regionName}{vbLf}// void Old(){vbLf}#endregion{vbLf}{vbLf}public class C {{ public void M() {{}} }}{vbLf}"
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            Dim text As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs")
            Assert.DoesNotContain("Old()", text)
            Assert.Contains("void C.M()", text)

        End Using

    End Sub

    ''' <summary>
    ''' The second run on a file that was already updated finds the region up to date: nothing is written (the bytes and
    ''' the last-write time are the same).
    ''' </summary>
    <WindowsOnlyTheory>
    <InlineData("a.cs")>
    <InlineData("a.vb")>
    Public Sub Run_SecondRun_FindsTheRegionUpToDate_AndDoesNotWriteTheFile(fileName As String)

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText(fileName, If(fileName.EndsWith(".cs", StringComparison.Ordinal), ProgramEndToEndTests.CsSource, ProgramEndToEndTests.VbSource), ProgramEndToEndTests.NoBomUtf8)

            ProgramEndToEndTests.AssertSummary(1, 0, 0, sandbox.Run())

            Dim bytesAfterFirstRun As Byte() = sandbox.Source.ReadBytes(fileName)
            Dim timeAfterFirstRun As Date = File.GetLastWriteTimeUtc(sandbox.Source.GetPath(fileName))
            Threading.Thread.Sleep(1100)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(0, 1, 0, result)
            ProgramEndToEndTests.AssertOutputContains("is up to date", result)
            Assert.Equal(bytesAfterFirstRun, sandbox.Source.ReadBytes(fileName))
            Assert.Equal(timeAfterFirstRun, File.GetLastWriteTimeUtc(sandbox.Source.GetPath(fileName)))

        End Using

    End Sub

    ''' <summary>
    ''' The date and time in the header of an existing region, and the order of its lines, are not a reason to rewrite the file.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_RegionWithAnotherDateAndOrder_IsConsideredUpToDate()

        Using sandbox As New ProgramSandbox()

            Dim original As String =
                "#region Public Members Summary (auto-generated with CS-VB_PMS_Gen on January 1, 2000 @ 00:00:00)" & vbLf &
                vbLf &
                "// 🧠 Methods" & vbLf &
                "// ▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔" & vbLf &
                "// void C.B()" & vbLf &
                "// void C.A()" & vbLf &
                vbLf &
                "#endregion" & vbLf &
                vbLf &
                "public class C { public void A() {} public void B() {} }" & vbLf
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(0, 1, 0, result)
            Assert.Equal(original, ProgramEndToEndTests.ReadText(sandbox, "a.cs"))

        End Using

    End Sub

    ''' <summary>
    ''' When the code changes, the next run updates the region with the new members.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_AfterChangingTheCode_TheRegionIsUpdated()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, sandbox.Run())

            Dim updated As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs").Replace("public void M() {}", "public void M() {} public int NewMember;")
            sandbox.Source.WriteText("a.cs", updated, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertSummary(1, 0, 0, result)
            Dim text As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs")
            Assert.Contains("// int C.NewMember", text)
            Assert.Equal(1, ProgramEndToEndTests.CountOf(text, "#region Public Members Summary"))

        End Using

    End Sub

    ''' <summary>
    ''' When the file no longer has public members, its old region is removed.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_RegionOfAFileWithoutPublicMembers_IsRemoved()

        Using sandbox As New ProgramSandbox()

            Dim original As String = "#region Public Members Summary (old)" & vbLf & "// void Old()" & vbLf & "#endregion" & vbLf & vbLf & "class C { }" & vbLf
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, result)
            ProgramEndToEndTests.AssertOutputContains("Summary region was successfully removed from file", result)
            ProgramEndToEndTests.AssertOutputContains("[WARN]", result)

            Dim text As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs")
            Assert.DoesNotContain("Public Members Summary", text)
            Assert.Contains("class C { }", text)

        End Using

    End Sub

#End Region

#Region " Malformed Files "

    ''' <summary>
    ''' A summary region that is never closed makes the file invalid: it is reported as failed and left untouched.
    ''' </summary>
    <WindowsOnlyTheory>
    <InlineData("a.cs", "#region Public Members Summary (old)" & vbLf & "// void Old()" & vbLf & vbLf & "public class C { public void M() {} }" & vbLf)>
    <InlineData("a.vb", "#Region "" Public Members Summary (old) """ & vbLf & "' C.Old()" & vbLf & vbLf & "Public Class C" & vbLf & "    Public Sub M()" & vbLf & "    End Sub" & vbLf & "End Class" & vbLf)>
    Public Sub Run_RegionWithoutItsEnd_IsReportedAsFailed_AndTheFileIsNotModified(fileName As String, original As String)

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText(fileName, original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(1, result)
            ProgramEndToEndTests.AssertSummary(0, 0, 1, result)
            ProgramEndToEndTests.AssertOutputContains("[ ERROR ]", result)
            Assert.Equal(original, ProgramEndToEndTests.ReadText(sandbox, fileName))

        End Using

    End Sub

    ''' <summary>
    ''' A file with a syntax error is reported as failed and left untouched, and the rest of the files are still processed.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_FileWithSyntaxErrors_IsReportedAsFailed_AndTheOtherFilesAreProcessed()

        Using sandbox As New ProgramSandbox()

            Dim broken As String = "public class {" & vbLf
            sandbox.Source.WriteText("a_broken.cs", broken, ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("b_good.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(1, result)
            ProgramEndToEndTests.AssertSummary(1, 0, 1, result)
            ProgramEndToEndTests.AssertOutputContains("An error occurred while processing the file", result)
            ProgramEndToEndTests.AssertOutputContains("Syntax compilation error", result)
            Assert.Equal(broken, ProgramEndToEndTests.ReadText(sandbox, "a_broken.cs"))
            Assert.Contains("#region Public Members Summary", ProgramEndToEndTests.ReadText(sandbox, "b_good.cs"))

        End Using

    End Sub

    ''' <summary>
    ''' A file with two summary regions is reported as an error (and the run ends with exit code 1).
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_FileWithTwoSummaryRegions_IsReportedAsAnError()

        Using sandbox As New ProgramSandbox()

            Dim original As String =
                "#region Public Members Summary (old)" & vbLf & "// void Old()" & vbLf & "#endregion" & vbLf & vbLf &
                "#region Public Members Summary (old2)" & vbLf & "// void Old2()" & vbLf & "#endregion" & vbLf & vbLf &
                "public class C { public void M() {} }" & vbLf
            sandbox.Source.WriteText("a.cs", original, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(1, result)
            ProgramEndToEndTests.AssertOutputContains("Multiple 'Public Members Summary' regions detected", result)

        End Using

    End Sub

#End Region

#Region " Encodings "

    ''' <summary>
    ''' Every supported encoding variant is rewritten with the same encoding and the same BOM (or absence of BOM).
    ''' The file starts with the BOM bytes, and its content is the region plus the original text.
    ''' </summary>
    <WindowsOnlyTheory>
    <InlineData("UTF8")>
    <InlineData("UTF8_Bom")>
    <InlineData("UTF16LE")>
    <InlineData("UTF16LE_Bom")>
    <InlineData("UTF16BE")>
    <InlineData("UTF16BE_Bom")>
    <InlineData("UTF32LE")>
    <InlineData("UTF32LE_Bom")>
    <InlineData("UTF32BE")>
    <InlineData("UTF32BE_Bom")>
    Public Sub Run_PreservesTheEncodingAndTheBomOfTheFile(encodingName As String)

        Using sandbox As New ProgramSandbox()

            Dim encoding As Encoding = TestEncodings.Create(encodingName)
            Dim original As Byte() = TestEncodings.Encode(ProgramEndToEndTests.CsSource, encoding)
            sandbox.Source.WriteBytes("a.cs", original)

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(0, result)
            ProgramEndToEndTests.AssertSummary(1, 0, 0, result)

            Dim written As Byte() = sandbox.Source.ReadBytes("a.cs")
            Dim preamble As Byte() = encoding.GetPreamble()
            Assert.Equal(preamble, written.Take(preamble.Length).ToArray())

            Dim text As String = ProgramEndToEndTests.Decode(written, encoding)
            Assert.Contains("#region Public Members Summary", text)
            Assert.Equal(ProgramEndToEndTests.CsSource, ProgramEndToEndTests.Lf(ProgramEndToEndTests.WithoutRegion(text)))

            ' Re-encoding the decoded text must give the same bytes: the file has no stray bytes nor other BOM.
            Assert.Equal(written, TestEncodings.Encode(text, encoding))

        End Using

    End Sub

