        End Using

    End Sub

    ''' <summary>
    ''' The banner of the run shows the number of files found of each kind.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_ShowsTheNumberOfFilesFound()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("b.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("c.vb", ProgramEndToEndTests.VbSource, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.Run("--test")

