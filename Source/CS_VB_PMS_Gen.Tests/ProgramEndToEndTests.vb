#Region " Option Statements "

Option Strict On
Option Explicit On
Option Infer Off

#End Region

#Region " Imports "

Imports System
Imports System.IO
Imports System.Linq
Imports System.Text
Imports System.Text.RegularExpressions

Imports Xunit

#End Region

#Region " ProgramEndToEndTests "

''' <summary>
''' End-to-end tests of the entry point: the real application is executed as a separate process
''' against temporary directories, and its exit code, its output and the resulting files are verified.
''' <para></para>
''' They run on Windows only, because the application converts every path to the Windows extended-length format ("\\?\").
''' </summary>
Public Class ProgramEndToEndTests

#Region " Constants and Fields "

    ''' <summary>
    ''' A small C# source with one public member, and with accented text.
    ''' </summary>
    Private Const CsSource As String = "// Ñandú café" & vbLf & "using System;" & vbLf & "public class C { public void M() {} }" & vbLf

    ''' <summary>
    ''' A small Visual Basic source with one public member.
    ''' </summary>
    Private Const VbSource As String = "Option Strict On" & vbLf & "Imports System" & vbLf & "Public Class C" & vbLf & "    Public Sub M()" & vbLf & "    End Sub" & vbLf & "End Class" & vbLf

    ''' <summary>
    ''' A C# source without public members.
    ''' </summary>
    Private Const CsWithoutMembers As String = "internal class C { public void M() {} }" & vbLf

    ''' <summary>
    ''' Matches the region generated by the application, together with the two line breaks that the application adds after it.
    ''' </summary>
    Private Shared ReadOnly GeneratedRegion As New Regex(
        "#(?:region|Region) ""? ?Public Members Summary[\s\S]*?#(?:endregion|End Region)(?:\r?\n){2}", RegexOptions.CultureInvariant)

    ''' <summary>
    ''' Encodings supported by the application.
    ''' </summary>
    Private Shared ReadOnly NoBomUtf8 As New UTF8Encoding(False)

#End Region

#Region " Private Methods "

    ''' <summary>
    ''' Asserts that a run ended with the expected exit code, showing the complete output if it did not.
    ''' </summary>
    Private Shared Sub AssertExitCode(expected As Integer, result As ProgramRunResult)

        Assert.True(expected = result.ExitCode, $"Expected exit code {expected}.{Environment.NewLine}{result}")

    End Sub

    ''' <summary>
    ''' Asserts that the output of a run contains a text, showing the complete output if it does not.
    ''' </summary>
    Private Shared Sub AssertOutputContains(expectedText As String, result As ProgramRunResult)

        Assert.True(result.StandardOutput.Contains(expectedText, StringComparison.Ordinal),
                    $"The output does not contain: {expectedText}{Environment.NewLine}{result}")

    End Sub

    ''' <summary>
    ''' Asserts the final counters printed by the application.
    ''' </summary>
    Private Shared Sub AssertSummary(modified As Integer, skipped As Integer, failed As Integer, result As ProgramRunResult)

        ProgramEndToEndTests.AssertOutputContains($"All files have been processed. Modified: {modified}; Skipped: {skipped}; Failed: {failed}.", result)

    End Sub

    ''' <summary>
    ''' Decodes the bytes of a file with the specified encoding, ignoring its BOM.
    ''' </summary>
    Private Shared Function Decode(bytes As Byte(), encoding As Encoding) As String

        Dim preamble As Byte() = encoding.GetPreamble()
        Dim skip As Integer = If(preamble.Length > 0 AndAlso bytes.Take(preamble.Length).SequenceEqual(preamble), preamble.Length, 0)

        Return encoding.GetString(bytes, skip, bytes.Length - skip)

    End Function

    ''' <summary>
    ''' Reads a file of the sandbox as UTF-8 text.
    ''' </summary>
    Private Shared Function ReadText(sandbox As ProgramSandbox, relativePath As String) As String

        Return ProgramEndToEndTests.Decode(sandbox.Source.ReadBytes(relativePath), ProgramEndToEndTests.NoBomUtf8)

    End Function

    ''' <summary>
    ''' Returns the text with the line breaks unified to LF.
    ''' </summary>
    Private Shared Function Lf(text As String) As String

        Return text.Replace(vbCrLf, vbLf)

    End Function

    ''' <summary>
    ''' Returns the text without the region generated by the application.
    ''' </summary>
    Private Shared Function WithoutRegion(text As String) As String

        Return ProgramEndToEndTests.GeneratedRegion.Replace(text, String.Empty)

    End Function

    ''' <summary>
    ''' Counts how many times a text appears in another one.
    ''' </summary>
    Private Shared Function CountOf(text As String, value As String) As Integer

        Dim total As Integer = 0
        Dim index As Integer = text.IndexOf(value, StringComparison.Ordinal)
        Do While index >= 0
            total += 1
            index = text.IndexOf(value, index + value.Length, StringComparison.Ordinal)
        Loop

        Return total

    End Function

#End Region

#Region " Arguments And Exit Codes "

    <WindowsOnlyFact>
    Public Sub Run_WithoutArguments_ShowsUsageAndExitsWith1()

        Using sandbox As New ProgramSandbox()

            Dim result As ProgramRunResult = sandbox.RunRaw()

            ProgramEndToEndTests.AssertExitCode(1, result)
            ProgramEndToEndTests.AssertOutputContains("Usage:", result)
            ProgramEndToEndTests.AssertOutputContains("-r, --recursive", result)
            ProgramEndToEndTests.AssertOutputContains("-t, --test", result)
            ProgramEndToEndTests.AssertOutputContains("Missing required argument(s)", result)

        End Using

    End Sub

    <WindowsOnlyFact>
    Public Sub Run_WithADirectoryThatDoesNotExist_ExitsWith3()

        Using sandbox As New ProgramSandbox()

            Dim result As ProgramRunResult = sandbox.RunRaw(sandbox.Source.GetPath("does-not-exist"))

            ProgramEndToEndTests.AssertExitCode(3, result)
            ProgramEndToEndTests.AssertOutputContains("The specified directory path does not exist", result)

        End Using

    End Sub

    ''' <summary>
    ''' A path to a file (instead of a directory) is not a valid directory.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_WithAFilePathInsteadOfADirectory_ExitsWith3()

        Using sandbox As New ProgramSandbox()

            Dim filePath As String = sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)

            Dim result As ProgramRunResult = sandbox.RunRaw(filePath)

            ProgramEndToEndTests.AssertExitCode(3, result)
            Assert.Equal(ProgramEndToEndTests.CsSource, ProgramEndToEndTests.ReadText(sandbox, "a.cs"))

        End Using

    End Sub

    <WindowsOnlyFact>
    Public Sub Run_WithAnEmptyDirectory_ExitsWith4()

        Using sandbox As New ProgramSandbox()

            Dim result As ProgramRunResult = sandbox.Run()

            ProgramEndToEndTests.AssertExitCode(4, result)
            ProgramEndToEndTests.AssertOutputContains("No supported files were found", result)

        End Using

    End Sub

    <WindowsOnlyFact>
    Public Sub Run_WithoutCsOrVbFiles_ExitsWith4()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("readme.txt", "x", ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("app.vbproj", "<Project />", ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("script.csx", "int x = 1;", ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("sub/b.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8) ' Only found with "-r".

