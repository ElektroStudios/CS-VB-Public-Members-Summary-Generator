#Region " Processing "

    ''' <summary>
    ''' The files are processed in natural order (file2 before file10), and each one is numbered in the output.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_ProcessesTheFilesInNaturalOrder()

        Using sandbox As New ProgramSandbox()

            For Each name As String In {"file10.cs", "file2.cs", "file1.cs"}
                sandbox.Source.WriteText(name, ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            Next name

            Dim result As ProgramRunResult = sandbox.Run("--test")
            Dim output As String = result.StandardOutput

            Dim first As Integer = output.IndexOf("[1 of 3] Processing file:", StringComparison.Ordinal)
            Dim second As Integer = output.IndexOf("[2 of 3] Processing file:", StringComparison.Ordinal)
            Dim third As Integer = output.IndexOf("[3 of 3] Processing file:", StringComparison.Ordinal)

            Assert.True(first >= 0 AndAlso second > first AndAlso third > second, result.ToString())
            Assert.Contains("file1.cs", output.Substring(first, second - first))
            Assert.Contains("file2.cs", output.Substring(second, third - second))
            Assert.Contains("file10.cs", output.Substring(third))

        End Using

    End Sub

