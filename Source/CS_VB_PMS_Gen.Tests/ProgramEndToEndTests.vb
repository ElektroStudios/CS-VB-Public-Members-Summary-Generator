#Region " Failures And Clean Up "

    ''' <summary>
    ''' A file that cannot be processed (here, it is locked by another process) makes the run end with exit code 1,
    ''' but it does not stop the processing of the rest of the files, and the locked file is left intact.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_WhenAFileCannotBeProcessed_ReportsItContinuesAndExitsWith1()

        Using sandbox As New ProgramSandbox()

            Dim original As Byte() = TestEncodings.Encode(ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            Dim lockedPath As String = sandbox.Source.WriteBytes("a_locked.cs", original)
            sandbox.Source.WriteBytes("b_free.cs", original)

            Dim result As ProgramRunResult
            Using locker As New FileStream(lockedPath, FileMode.Open, FileAccess.ReadWrite, FileShare.None)
                result = sandbox.Run()
            End Using

            ProgramEndToEndTests.AssertExitCode(1, result)
            ProgramEndToEndTests.AssertSummary(1, 0, 1, result)
            ProgramEndToEndTests.AssertOutputContains("An error occurred while processing the file", result)
            Assert.Equal(original, sandbox.Source.ReadBytes("a_locked.cs"))
            Assert.NotEqual(original, sandbox.Source.ReadBytes("b_free.cs"))

        End Using

    End Sub

    ''' <summary>
    ''' After a real run, only the original files are in the directory: no temporary (.tmp) or backup (.bak) files remain,
    ''' neither next to the files nor in the temporary directory.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_LeavesNoTemporaryOrBackupFilesBehind()

        Using sandbox As New ProgramSandbox()

            sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            sandbox.Source.WriteText("sub/b.vb", ProgramEndToEndTests.VbSource, New UTF8Encoding(True))
            sandbox.Source.WriteText("c.cs", "public class Q { private int X; }" & vbLf, ProgramEndToEndTests.NoBomUtf8) ' Skipped: no public members.

            Dim result As ProgramRunResult = sandbox.Run("-r")

            ProgramEndToEndTests.AssertExitCode(0, result)
            Dim names As String() = sandbox.Source.GetAllFileNames()
            Assert.Equal(New String() {"a.cs", "c.cs", "sub/b.vb"}.OrderBy(Function(n As String) n, StringComparer.Ordinal),
             names.OrderBy(Function(n As String) n, StringComparer.Ordinal))
            Assert.Empty(sandbox.Scratch.GetAllFileNames())

        End Using

    End Sub

    ''' <summary>
    ''' The attributes (read-only flag) of a file are not a reason to lose the update: a read-only file is reported as failed
    ''' and kept intact, or updated; in both cases there are no leftovers and the original content is never lost.
    ''' </summary>
    <WindowsOnlyFact>
    Public Sub Run_ReadOnlyFile_NeverLosesItsContent()

        Using sandbox As New ProgramSandbox()

            Dim filePath As String = sandbox.Source.WriteText("a.cs", ProgramEndToEndTests.CsSource, ProgramEndToEndTests.NoBomUtf8)
            File.SetAttributes(filePath, FileAttributes.ReadOnly)
            Try
                Dim result As ProgramRunResult = sandbox.Run()

                Dim text As String = ProgramEndToEndTests.ReadText(sandbox, "a.cs")
                Assert.Equal(ProgramEndToEndTests.CsSource, ProgramEndToEndTests.Lf(ProgramEndToEndTests.WithoutRegion(text)))
                Assert.DoesNotContain(".tmp", String.Join("|", sandbox.Source.GetAllFileNames()), StringComparison.OrdinalIgnoreCase)
                Assert.DoesNotContain(".bak", String.Join("|", sandbox.Source.GetAllFileNames()), StringComparison.OrdinalIgnoreCase)
            Finally
                File.SetAttributes(filePath, FileAttributes.Normal)
            End Try

        End Using

    End Sub

