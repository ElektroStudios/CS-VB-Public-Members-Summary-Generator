<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <RootNamespace>CS_VB_PMS_Gen.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to your main .NET 10 project -->
    <!-- Make sure to place the tests folder next to the Source folder -->
    <!--
      The application is always built in Release configuration for the tests, whatever the configuration of the test project is:
      the end-to-end tests execute the real application as a separate process, and its Debug build waits for key presses
      (Console.ReadKey) that nobody can press in an automated run.
    -->
    <ProjectReference Include="..\net10 project\CS-VB_PMS_Gen_net10.vbproj" />
  </ItemGroup>

  <Target Name="UseReleaseBuildOfTheApplication" AfterTargets="Build">
    <MSBuild Projects="..\net10 project\CS-VB_PMS_Gen_net10.vbproj" Targets="Build" Properties="Configuration=Release">
      <Output TaskParameter="TargetOutputs" ItemName="ReleaseAppAssembly" />
    </MSBuild>
    <ItemGroup>
      <ReleaseAppFiles Include="%(ReleaseAppAssembly.RootDir)%(ReleaseAppAssembly.Directory)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReleaseAppFiles)" DestinationFolder="$(OutDir)" />
  </Target>
  
</Project>
